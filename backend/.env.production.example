# =============================================================
# Öde - Backend PRODUCTION env (VPS)
# Dosyayı kopyalayın: cp .env.production.example .env
# Sonra DEĞERLERİ doldurun.
# =============================================================

NODE_ENV=production
# 5000 eski Python botu tarafından kullanılıyor — 5050'ye alındı.
PORT=5050

# Birden fazla origin: virgülle ayır
CLIENT_URL=https://tunatest2.site,https://www.tunatest2.site

# Express'in arkasındaki proxy (Nginx) sayısı
TRUST_PROXY=1

# Neon connection string — Neon panelinden kopyala
# Örn: postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/ode_db?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/ode_db?sslmode=require
PGSSL=true

# JWT secret — UZUN ve RASTGELE olmalı
# Üretmek için (linux): openssl rand -hex 48
JWT_SECRET=__REPLACE_WITH_64_CHARS_HEX__
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
