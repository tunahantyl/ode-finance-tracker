# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ode_db
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=ode_db

# Auth
JWT_SECRET=replace_this_with_a_long_random_string_in_production
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10
